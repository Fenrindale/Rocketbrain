# Public-source allowlist. Local investigation and validation evidence stay private.
/*
!/.gitignore
!/.gitattributes
!/.vscodeignore
!/README.md
!/NOTICE.txt
!/THIRD-PARTY-LICENSES.txt
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/.github/
!/.github/**
!/.vscode/
!/.vscode/launch.json
!/.vscode/tasks.json
!/architecture/
!/architecture/product-policy.json
!/docs/
!/docs/**
!/media/
!/media/**
!/themes/
!/themes/**
!/third-party/
!/third-party/licenses/
!/third-party/licenses/**
!/src/
!/src/**
!/runtime/
!/runtime/**
!/scripts/
!/scripts/*.js
!/scripts/*.ps1
!/test/
!/test/**

# Historical release writers require private evidence and are not a public tool.
/scripts/record-v*.js
/scripts/observe-reference.ps1

# Never publish generated state, IDE metadata, compiled code, or credentials.
**/node_modules/
**/dist/
**/target/
**/build/
**/bin/
**/.gradle/
**/.idea/
**/.settings/
**/.classpath
**/.project
**/.vscode/
!/.vscode/
!/.vscode/launch.json
!/.vscode/tasks.json
**/.env
**/.env.*
**/*.vsix
**/*.class
**/*.jar
**/*.zip
**/*.tar
**/*.gz
**/*.exe
**/*.dll
**/*.wasm
**/*.cany
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.sqlite*
**/connection*.local.json
**/application-local.*

# Owned v0.23 package test input, generated from pinned fixture bytes.
/test/fixtures/refactoring-v23-package/src/package-assets/fixture/packagev23/payload/payload.bin
/test/fixtures/refactoring-v23-package/src/package-assets/fixture/packagev23/relocated/payload.bin
