  "newlyVerified": {
    "IDEA-045": {
      "scope": "별도 Ubuntu에서 실제 Kotlin/Native 2.4.21 실행 파일을 만들고 GDB 15.1로 중단점 68행과 다음 69행을 확인했다. 두 DB에서 지역 변수 41이 42가 됐고 재개 후 Spring HTTP와 JDBC 결과가 일치했다.",
      "runtimeGroups": [
        "kotlinNativeDebug"
      ]
    },
    "IDEA-053": {
      "scope": "실제 Spring Boot 4.1.2의 Gradle processAot와 bootJar를 실행했다. 두 DB에서 빌드 조건으로 activeProbe를 추가하거나 제거한 결과가 생성 보고서와 일치했다. 별칭과 정확한 @Bean 선언 이동을 확인했다.",
      "runtimeGroups": [
        "springAot"
      ]
    },
    "IDEA-066": {
      "scope": "실제 Maven·Gradle Quarkus 개발 JVM에서 소스 중단점과 지역 변수를 읽었다. HTTP가 중단된 상태에서 디버거를 분리해 응답을 완료했고, 분리 중 소스를 다시 읽은 뒤 같은 JVM에 연결해 새 값을 확인했다. 두 DB와 Spring을 대조했고 별도 Linux Gradle ELF도 같은 JDBC 값을 반환했다.",
      "runtimeGroups": [
        "quarkusAttachableDev",
        "quarkusGradleNative"
      ]
    }
