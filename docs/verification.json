  "newlyVerified": {
    "IDEA-024": {
      "scope": "실제 Javac와 JDT가 모듈 지시문 8개를 검토했다. 두 DB의 설치본에서 새 이름을 적용한 5개 위치와 Java 패키지를 한 번에 실행 취소하고 다시 실행했다. 공급자 순서와 값 29·17 및 외부 Spring 앱의 JDBC 결과 42가 유지됐다.",
      "runtimeGroups": [
        "jpmsPackageRename"
      ]
    },
    "IDEA-030": {
      "scope": "실제 JDT와 Spring 컨텍스트에서 삭제한 필드만 사라졌다. MySQL·MariaDB의 JDBC 값 42, Spring 주입 값 71과 보호된 초기화 호출 횟수 1이 유지됐다.",
      "runtimeGroups": [
        "safeFieldDelete"
      ]
    },
    "IDEA-067": {
      "scope": "별도 Linux에서 Micronaut GraalVM ELF를 실제 실행하고 두 DB의 Spring 비교 앱과 결과를 대조했다. 실제 JDT Buildship과 Gradle로 재시작 후보를 검증했으며 실패하거나 취소했을 때 기존 HTTP·JDBC JVM이 계속 동작했다.",
      "runtimeGroups": [
        "micronautNative",
        "micronautGradleRestart"
      ]
    },
    "IDEA-079": {
      "scope": "설치본에서 Reactor Core 3.8.8의 실제 두 스케줄러 작업의 부모와 워커를 확인했다. 별도 실제 JDT 연결도 통과했다. 두 DB의 Spring JDBC 결과 42가 유지됐고 재개한 프레임과 등록하지 않은 워커는 거부했다.",
      "runtimeGroups": [
        "reactorAsync"
      ]
    },
    "IDEA-097": {
      "scope": "별도 실제 WSL 2 설치본에서 변경 감지·읽기 전용 차이·저장하지 않은 편집 보존·다른 편집기 포커스 유지와 선택 재로드를 확인했다. 줄 중단점과 스텝으로 실제 Spring JVM을 제어했고 MySQL·MariaDB의 Linux JDBC와 Windows 쿼리가 각각 42로 일치했다.",
      "runtimeGroups": [
        "wslSourceWatch"
      ]
    }
  },
