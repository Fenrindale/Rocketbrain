{
  "name": "Java Regular Expression",
  "scopeName": "source.rocketbrain-java-regex",
  "patterns": [
    { "include": "#quoted" },
    { "include": "#escape" },
    { "include": "#character-class" },
    { "match": "\\(\\?<([A-Za-z][A-Za-z0-9]*)>", "name": "keyword.operator.group.regexp", "captures": { "1": { "name": "entity.name.section.regexp" } } },
    { "match": "\\(\\?(?:[idmsuxU]+(?:-[idmsuxU]+)?[:)]|[=!>:]|<[=!])", "name": "keyword.operator.group.regexp" },
    { "match": "(?:[?*+]|\\{[0-9]+(?:,[0-9]*)?\\})[?+]?", "name": "keyword.operator.quantifier.regexp" },
    { "match": "[()|^$.]", "name": "keyword.operator.regexp" }
  ],
  "repository": {
    "escape": {
      "match": "\\\\(?:[pP]\\{[^}\\n]+\\}|k<[A-Za-z][A-Za-z0-9]*>|x\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|.)",
      "name": "constant.character.escape.regexp"
    },
    "quoted": {
      "begin": "\\\\Q", "end": "\\\\E", "name": "string.quoted.other.regexp"
    },
    "character-class": {
      "begin": "\\[", "end": "\\]", "name": "constant.other.character-class.regexp",
      "patterns": [ { "include": "#quoted" }, { "include": "#escape" }, { "include": "#character-class" } ]
    }
  }
}
