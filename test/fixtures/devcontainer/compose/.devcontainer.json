{
  "name": "Rocketbrain Compose fixture",
  "dockerComposeFile": ["compose.yaml", "compose.workspace.yaml"],
  "service": "workspace",
  "runServices": ["workspace"],
  "workspaceFolder": "/workspaces/compose",
  "overrideCommand": false,
  "postCreateCommand": "printf ready-compose > /tmp/rocketbrain-devcontainer-ready"
}
