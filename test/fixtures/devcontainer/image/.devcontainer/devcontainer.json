{
  // The official CLI expands the workspace basename before starting the image.
  "name": "Rocketbrain Dev Container image",
  "image": "ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteEnv": { "ROCKETBRAIN_CONTAINER_FIXTURE": "managed-image" },
  "waitFor": "postCreateCommand",
  "postCreateCommand": ["sh", "-c", "printf 'ready-image' > /tmp/rocketbrain-devcontainer-ready"],
}
