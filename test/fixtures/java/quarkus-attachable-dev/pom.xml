<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>rocketbrain.fixture</groupId><artifactId>quarkus-attachable-dev</artifactId><version>1.0.0</version>
