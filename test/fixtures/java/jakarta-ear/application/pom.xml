<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>rocketbrain.fixture</groupId><artifactId>wildfly-ear-reactor</artifactId><version>1.0.0</version></parent>
  <artifactId>wildfly-ear-application</artifactId>
  <packaging>ear</packaging>
  <dependencies>
    <dependency><groupId>rocketbrain.fixture</groupId><artifactId>wildfly-ear-web</artifactId><version>1.0.0</version><type>war</type></dependency>
    <dependency><groupId>rocketbrain.fixture</groupId><artifactId>wildfly-ear-beans</artifactId><version>1.0.0</version><type>ejb</type></dependency>
    <dependency><groupId>rocketbrain.fixture</groupId><artifactId>wildfly-ear-contract</artifactId><version>1.0.0</version></dependency>
  </dependencies>
  <build><plugins><plugin><artifactId>maven-ear-plugin</artifactId>
    <configuration>
      <version>11</version>
      <defaultLibBundleDir>lib</defaultLibBundleDir>
      <modules>
        <webModule>
          <groupId>rocketbrain.fixture</groupId><artifactId>wildfly-ear-web</artifactId>
          <bundleFileName>inventory-web.war</bundleFileName><contextRoot>/rb-enterprise</contextRoot>
        </webModule>
        <ejbModule>
          <groupId>rocketbrain.fixture</groupId><artifactId>wildfly-ear-beans</artifactId>
          <bundleFileName>inventory-beans.jar</bundleFileName>
        </ejbModule>
      </modules>
    </configuration>
  </plugin></plugins></build>
</project>
