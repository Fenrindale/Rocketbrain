    "tab.inactiveBackground": "#1A1D22",
    "tab.inactiveForeground": "#8E98A7",
    "tab.border": "#30343C",
    "tab.activeBorderTop": "#B6A5E8",
    "tab.unfocusedActiveBorderTop": "#766997",
    "tab.hoverBackground": "#282C35",
    "list.activeSelectionBackground": "#3A354B",
    "list.activeSelectionForeground": "#E5DFEF",
    "list.inactiveSelectionBackground": "#303440",
    "list.inactiveSelectionForeground": "#D7DCE5",
    "list.hoverBackground": "#2B303A",
    "list.focusBackground": "#3A354B",
    "list.focusForeground": "#E5DFEF",
    "list.highlightForeground": "#CCBDF5",
    "list.focusHighlightForeground": "#E0D3FF",
    "list.dropBackground": "#B6A5E822",
    "tree.indentGuidesStroke": "#3C424E",
    "input.background": "#252A33",
    "input.foreground": "#D7DCE5",
    "input.border": "#414957",
    "input.placeholderForeground": "#8A95A6",
    "inputOption.activeBackground": "#B6A5E833",
    "inputOption.activeBorder": "#B6A5E8",
    "dropdown.background": "#252A33",
    "dropdown.foreground": "#D7DCE5",
    "dropdown.border": "#414957",
    "button.background": "#76639E",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#8975B2",
    "button.secondaryBackground": "#353B47",
    "button.secondaryForeground": "#D7DCE5",
    "button.secondaryHoverBackground": "#454D5D",
    "badge.background": "#464052",
    "badge.foreground": "#E3DAF4",
    "progressBar.background": "#B6A5E8",
    "quickInput.background": "#252932",
    "quickInput.foreground": "#D7DCE5",
    "quickInputTitle.background": "#2D323D",
    "quickInputList.focusBackground": "#423952",
    "quickInputList.focusForeground": "#EFE7FF",
    "editorWidget.background": "#252932",
    "editorWidget.foreground": "#D7DCE5",
    "editorWidget.border": "#414957",
    "editorSuggestWidget.selectedBackground": "#423952",
    "editorSuggestWidget.highlightForeground": "#CCBDF5",
    "editorHoverWidget.background": "#252932",
    "editorHoverWidget.border": "#414957",
    "panel.background": "#1C1F25",
    "panel.border": "#30343C",
    "panelTitle.activeForeground": "#E1E5EC",
    "panelTitle.inactiveForeground": "#8E98A7",
    "panelTitle.activeBorder": "#B6A5E8",
    "statusBar.background": "#252932",
    "statusBar.foreground": "#BFC7D5",
    "statusBar.border": "#30343C",
    "statusBar.noFolderBackground": "#252932",
    "statusBar.debuggingBackground": "#493C59",
    "statusBarItem.hoverBackground": "#FFFFFF12",
    "statusBarItem.remoteBackground": "#655585",
    "statusBarItem.remoteForeground": "#F1E9FF",
    "terminal.background": "#1C1F25",
    "terminal.foreground": "#D7DCE5",
    "terminalCursor.foreground": "#D7DCE5",
    "terminal.ansiBlack": "#343A45",
    "terminal.ansiRed": "#D9808B",
    "terminal.ansiGreen": "#A8C58D",
    "terminal.ansiYellow": "#D6B58A",
    "terminal.ansiBlue": "#8EAED3",
    "terminal.ansiMagenta": "#B6A5E8",
    "terminal.ansiCyan": "#8EC6C0",
    "terminal.ansiWhite": "#C1C8D4",
    "terminal.ansiBrightBlack": "#7C8594",
    "terminal.ansiBrightRed": "#F4A2AB",
    "terminal.ansiBrightGreen": "#C0DAA9",
    "terminal.ansiBrightYellow": "#E7CEA9",
    "terminal.ansiBrightBlue": "#AFC9EB",
    "terminal.ansiBrightMagenta": "#D3C2FC",
    "terminal.ansiBrightCyan": "#ACE0D8",
    "terminal.ansiBrightWhite": "#EDF0F5",
    "notificationCenterHeader.background": "#2D323D",
    "notifications.background": "#252932",
    "notifications.foreground": "#D7DCE5",
    "notifications.border": "#414957",
    "scrollbarSlider.background": "#7A859533",
    "scrollbarSlider.hoverBackground": "#7A859566",
    "scrollbarSlider.activeBackground": "#7A859588",
    "textLink.foreground": "#BCAEF0",
    "textLink.activeForeground": "#D8CDF8",
    "textCodeBlock.background": "#191C22",
    "textBlockQuote.background": "#252932",
    "textBlockQuote.border": "#76639E"
  },
  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7C8594", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#A8C58D" } },
    { "name": "Numbers and constants", "scope": ["constant.numeric", "constant.language", "constant.character", "variable.other.constant"], "settings": { "foreground": "#D6B58A" } },
    { "name": "Keywords", "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#B6A5E8" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#A8C4E8" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#D8C38E" } },
    { "name": "Variables", "scope": ["variable", "support.variable"], "settings": { "foreground": "#D7DCE5" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#C1C8D4" } },
    { "name": "Properties", "scope": ["variable.other.property", "support.type.property-name", "entity.other.attribute-name"], "settings": { "foreground": "#AFC8D4" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#B6A5E8" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#AAB2C0" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#8EC6C0" } },
    { "name": "Headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#D3C2FC", "fontStyle": "bold" } },
    { "name": "Emphasis", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Strong emphasis", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#A8C58D" } },
    { "name": "Deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#F08A92" } },
    { "name": "Changed", "scope": ["markup.changed"], "settings": { "foreground": "#D6B58A" } },
    { "name": "Invalid syntax", "scope": ["invalid"], "settings": { "foreground": "#F08A92" } }
  ],
  "semanticTokenColors": {
    "namespace": "#C1C8D4",
    "class": "#D8C38E",
    "interface": "#D8C38E",
    "enum": "#D8C38E",
    "typeParameter": "#D8C38E",
    "function": "#A8C4E8",
    "method": "#A8C4E8",
    "parameter": "#C1C8D4",
    "property": "#AFC8D4",
    "variable.readonly": "#D6B58A",
    "enumMember": "#D6B58A"
  }
}
