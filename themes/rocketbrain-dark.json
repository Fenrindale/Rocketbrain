    "editor.lineHighlightBackground": "#282C35",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#65558566",
    "editor.inactiveSelectionBackground": "#42475366",
    "editor.selectionHighlightBackground": "#65558540",
    "editor.wordHighlightBackground": "#8797BA26",
    "editor.wordHighlightStrongBackground": "#8797BA40",
    "editor.findMatchBackground": "#75603C",
    "editor.findMatchBorder": "#D6B58A",
